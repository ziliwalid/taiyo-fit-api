generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  password     String
  role         Role           @default(ADHERENT)
  nom          String
  prenom       String
  telephone               String?
  actif                   Boolean        @default(true)
  derniereMiseAJourProfil DateTime?
  reservations Reservation[]
  comptePack   ComptePack?
  demandesPack DemandePack[]
  paiements    Paiement[]
  coach              Coach?
  historiquesSessions HistoriqueSession[]
  notes               NoteCours[]
  createdAt          DateTime       @default(now())
}

enum Role {
  ADMIN
  COACH
  ADHERENT
}

model Coach {
  id            Int          @id @default(autoincrement())
  nom           String
  prenom        String
  cours         Cours[]
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id])
  utilisateurId Int?         @unique
}

model NoteCours {
  id            Int         @id @default(autoincrement())
  note          Int
  coursId       Int
  utilisateurId Int
  cours         Cours       @relation(fields: [coursId], references: [id])
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([utilisateurId, coursId])
}

model Cours {
  id           Int           @id @default(autoincrement())
  titre        String
  genre        GenreCours?
  dateHeure    DateTime
  dureeMinutes Int
  placesMax    Int
  coach        Coach         @relation(fields: [coachId], references: [id])
  coachId      Int
  reservations        Reservation[]
  historiquesSessions HistoriqueSession[]
  notes               NoteCours[]
  statutSeance        StatutSeance  @default(PLANIFIE)
  messageCoach String?
  adresse      String?
  imageUrl     String?
  createdAt    DateTime      @default(now())
}

enum GenreCours {
  BOOTCAMP
  HIIT
  YOGA
  PILATES
  TRAINING
}

enum StatutSeance {
  PLANIFIE
  EN_RETARD
  LIEU_MODIFIE
  ANNULE
  EFFECTUE
}

model Reservation {
  id            Int               @id @default(autoincrement())
  utilisateur   Utilisateur       @relation(fields: [utilisateurId], references: [id])
  utilisateurId Int
  cours         Cours             @relation(fields: [coursId], references: [id])
  coursId       Int
  statut        StatutReservation @default(EN_ATTENTE)
  createdAt     DateTime          @default(now())

  @@unique([utilisateurId, coursId])
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRME
  ANNULE
}

model Pack {
  id          Int           @id @default(autoincrement())
  nom         String
  nbSessions  Int
  tarif       Float?
  ancienTarif Float?
  description String?
  tag         String?
  actif       Boolean       @default(true)
  comptes     ComptePack[]
  demandes    DemandePack[]
  paiements   Paiement[]
}

model Paiement {
  id               String         @id @default(cuid())
  utilisateurId    Int
  packId           Int
  stripeSessionId  String         @unique
  stripePaymentId  String?
  montant          Float
  statut           StatutPaiement @default(EN_ATTENTE)
  createdAt        DateTime       @default(now())
  utilisateur      Utilisateur    @relation(fields: [utilisateurId], references: [id])
  pack             Pack           @relation(fields: [packId], references: [id])
}

enum StatutPaiement {
  EN_ATTENTE
  REUSSI
  ECHOUE
  REMBOURSE
}

model DemandePack {
  id            Int                @id @default(autoincrement())
  utilisateur   Utilisateur        @relation(fields: [utilisateurId], references: [id])
  utilisateurId Int
  pack          Pack               @relation(fields: [packId], references: [id])
  packId        Int
  statut        StatutDemande      @default(EN_ATTENTE)
  createdAt     DateTime           @default(now())
}

enum StatutDemande {
  EN_ATTENTE
  VALIDE
  REFUSE
}

model ComptePack {
  id                Int         @id @default(autoincrement())
  utilisateur       Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId     Int         @unique
  pack              Pack?       @relation(fields: [packId], references: [id])
  packId            Int?
  sessionsRestantes Int
  createdAt         DateTime    @default(now())
}

model HistoriqueSession {
  id            Int          @id @default(autoincrement())
  utilisateurId Int
  utilisateur   Utilisateur  @relation(fields: [utilisateurId], references: [id])
  variation     Int
  motif         String
  coursId       Int?
  cours         Cours?       @relation(fields: [coursId], references: [id])
  createdAt     DateTime     @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Evenement {
  id            Int       @id @default(autoincrement())
  titre         String
  contenu       String
  imageUrl      String?
  dateEvenement DateTime?
  tag           String?
  estPublic     Boolean   @default(true)
  epingle       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
